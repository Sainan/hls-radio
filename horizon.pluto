local scheduler = require "pluto:scheduler"
local { get_media, Radio } = require "libhlsradio"

local stations = {
	{ slug = "pulse", name = "Horizon Pulse", },
	{ slug = "bass-arena", name = "Horizon Bass Arena", },
	{ slug = "block-party", name = "Horizon Block Party", },
	{ slug = "xs", name = "Horizon XS", },
	{ slug = "hospital", name = "Hospital Records", },
	{ slug = "gacha-city", name = "Gacha City Radio", },
	{ slug = "sub-pop", name = "Sub Pop Records", },
	{ slug = "wave", name = "Horizon Wave", },
	{ slug = "opus", name = "Horizon Opus", },
}

do
	local fh <close> = io.open("index.html", "w")
	fh:write("<link rel=\"stylesheet\" href=\"https://calamity-inc.github.io/Silver/base.css\">")
	fh:write("<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n")
	fh:write("<p>Bootleg FH6 Radios:</o>")
	fh:write("<ul>\n")
	for stations as station do
		io.contents(
			station.slug..".html",
			io.contents("listen.tmpl.html"):replace("{{radio.name}}", station.name:replace(" Radio", "")):replace("{{radio.slug}}", station.slug)
		)
		fh:write("\t<li><a href=\""..station.slug..".html\">"..station.name.."</a></li>\n")
	end
	fh:write("</ul>")
end

local sched = new scheduler()
sched.yieldfunc = || -> os.sleep(1000)
for stations as station do
	local slug = station.slug

	local stingers = {}
	for io.scandir(slug .. "/stingers") as file do
		if io.isdir(file) do
			stingers:insert(get_media(file))
		end
	end
	local songs = {}
	for io.scandir(slug .. "/songs") as file do
		if io.isdir(file) do
			songs:insert(get_media(file))
		end
	end

	local radio = new Radio(slug .. ".m3u8")
	radio.recent_songs = {}
	sched:add(function()
		while true do
			if radio:tick() then
				local is_stinger = radio.track.segments[1]?.path?:startswith(slug.."/stingers/")
				if is_stinger then
					repeat
						radio.track = songs[math.random(1, #songs)]
					until not (radio.track in radio.recent_songs)
					radio.recent_songs:insert(radio.track)
					if #radio.recent_songs > 10 then
						radio.recent_songs:remove(1)
					end
				else
					radio.track = stingers[math.random(1, #stingers)]
				end
			else
				coroutine.yield()
			end
		end
	end)
end
sched:run()
